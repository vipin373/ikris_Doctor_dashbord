# --- Frontend (public, safe to expose) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ttvyxtjuypqvtdsssxpo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend only (never expose to the browser) ---------------------------
# Supabase > Project Settings > API > service_role. Needed for Google Sheet sync,
# inviting users and audit logs.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the deployed app, used in invitation e-mails.
APP_URL=
# Random string. Vercel Cron sends it to /api/cron/sync.
CRON_SECRET=

# Google service account (recommended). Share every sheet with GOOGLE_CLIENT_EMAIL as Viewer.
# Without it, sheets are read through their "Anyone with the link" CSV export.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PROJECT_ID=

# Optional
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=240

# --- Phase 2 (email / WhatsApp providers) ---------------------------------
EMAIL_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
