{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/app/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/fda-sync",
      "schedule": "0 21 * * *"
    }
  ]
}